async function enviarLineas(texto) {
  const getByXPath = (xpath) => {
    return document.evaluate(xpath, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;
  };

  const textareaXPath = '/html/body/div[1]/div/div/div[3]/div/div[4]/div/footer/div[1]/div/span/div/div[2]/div/div[4]';

  const lines = texto.split(/[\n\t]+/).map(line => line.trim()).filter(line => line);

  for (const line of lines) {
    const textarea = getByXPath(textareaXPath);

    if (!textarea) {
      console.error("⛔ No se encontró el área de texto.");
      break;
    }

    textarea.focus();
    document.execCommand("insertText", false, line);
    textarea.dispatchEvent(new Event("input", { bubbles: true }));

    // Esperar brevemente para que el botón aparezca
    await new Promise(r => setTimeout(r, 100));

    const sendButton = document.querySelector('button[aria-label="Enviar"]') ||
                       document.querySelector('[data-testid="send"]') ||
                       document.querySelector('[data-icon="send"]');

    if (!sendButton) {
      console.error("⛔ No se encontró el botón de enviar.");
      break;
    }

    sendButton.click();

    await new Promise(res => setTimeout(res, 300));
  }

  console.log(`✅ ${lines.length} líneas enviadas.`);
}

// 👉 Aquí va tu texto
enviarLineas(`
Hola
¿Todo bien?
Este mensaje es automático
`);
